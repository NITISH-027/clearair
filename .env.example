# Copy to .env (never commit .env). Every value is optional.
# Without GEMINI_API_KEY the app serves the clearly labelled rule-based plan.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=8080
# Set to 1 only when behind a trusted reverse proxy (Render, Cloud Run) so rate limits use X-Forwarded-For
TRUST_PROXY=
# Comma-separated list of extra browser origins allowed to call the API (same-origin is always allowed)
ALLOWED_ORIGINS=
