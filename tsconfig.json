{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "/shared/*": ["./shared/*"]
    }
  },
  "include": ["server.js", "server/**/*.js", "shared/**/*.js", "public/js/**/*.js"]
}
