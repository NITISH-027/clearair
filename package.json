{
  "name": "clearair",
  "version": "1.0.0",
  "description": "ClearAir: a winter-smog assistant that turns today's air quality into a personal plan and shows the impact of each choice.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test \"test/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-exclude=server.js --test-coverage-lines=98 --test-coverage-branches=95 --test-coverage-functions=98 \"test/*.test.js\"",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test:coverage",
    "typecheck": "tsc -p .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "eslint": "^9.0.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^4.2.3",
    "globals": "^15.0.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3"
  }
}
